# Для локальной проверки Docker-сборки:
APP_ENV=development
APP_URL=http://localhost:3000

# PostgreSQL внутри Docker
POSTGRES_DB=exam_platform
POSTGRES_USER=exam_app

# Сгенерировать:
# openssl rand -hex 24
POSTGRES_PASSWORD=replace_with_random_hex_password

# Сгенерировать:
# openssl rand -base64 48
JWT_SECRET=replace_with_long_random_jwt_secret

SESSION_COOKIE_NAME=exam_without_bugs_session
SESSION_TTL_DAYS=14
COOKIE_SECURE=false

# Видео «Как пользоваться платформой» на главной ученика.
ONBOARDING_VIDEO_URL=

# Telegram-напоминания. Включайте только после создания бота и webhook.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Сгенерировать отдельно для каждого секрета: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
REMINDER_CRON_SECRET=
