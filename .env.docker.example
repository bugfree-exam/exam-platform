# Для локальной проверки Docker-сборки:
APP_ENV=development
APP_URL=http://localhost:3000

# PostgreSQL внутри Docker
POSTGRES_DB=exam_platform
POSTGRES_USER=exam_app

# Сгенерировать:
# openssl rand -hex 24
POSTGRES_PASSWORD=replace_with_random_hex_password

# Сгенерировать:
# openssl rand -base64 48
JWT_SECRET=replace_with_long_random_jwt_secret

SESSION_COOKIE_NAME=exam_without_bugs_session
SESSION_TTL_DAYS=14
COOKIE_SECURE=false