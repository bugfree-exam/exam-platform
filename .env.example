# Окружение приложения:
# development | production | test
APP_ENV=development

# Локально:
APP_URL=http://localhost:3000

# Подключение к PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/exam_platform

# Сгенерировать командой:
# openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_secret_at_least_48_characters

# Cookie авторизации
SESSION_COOKIE_NAME=exam_without_bugs_session
SESSION_TTL_DAYS=14
COOKIE_SECURE=false

# Локальная папка загрузок
UPLOAD_DIR=./public/uploads

# Постоянная папка файлов, прикреплённых к заданиям
TASK_FILES_DIR=./storage/task-files

# Telegram-напоминания. Пока бот не настроен, оставьте false.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Секреты можно сгенерировать: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
REMINDER_CRON_SECRET=
