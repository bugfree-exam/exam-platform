[Unit]
Description=Exam Platform weekly backup restore verification
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/srv/exam-platform
ExecStart=/usr/bin/env bash /srv/exam-platform/scripts/restore-test-production.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
