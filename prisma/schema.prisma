generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  TEACHER
  STUDENT
}

enum StudentAccountStatus {
  ACTIVE
  FROZEN
  ARCHIVED
}

enum TaskAnswerType {
  TEXT
  NUMBER
  NUMBER_LIST
  PAIR_LIST_ORDERED
  PAIR_LIST_UNORDERED
}

enum HomeworkStatus {
  DRAFT
  ASSIGNED
  ARCHIVED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

enum ReminderChannel {
  TELEGRAM
}

enum ReminderKind {
  HOMEWORK_DUE_SOON
  HOMEWORK_OVERDUE
  VARIANT_DUE_SOON
  VARIANT_OVERDUE
}

enum ReminderResourceType {
  HOMEWORK
  VARIANT
}

enum VariantStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum WebinarVideoProvider {
  RUTUBE
  YANDEX_DISK
  EXTERNAL
}

enum WebinarStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum WebinarMaterialType {
  LINK
  CHEATSHEET
  PRESENTATION
  DOCUMENT
  CODE
  OTHER
}

enum StudyPlanStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum AiGenerationStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum StudyPlanAttemptKind {
  PRACTICE
  CONTROL
}

enum PracticeFeedbackStage {
  HINT
  SOLUTION
}

enum LearningErrorCause {
  THEORY_GAP
  ALGORITHM_GAP
  IMPLEMENTATION_ERROR
  CONDITION_READING
  CALCULATION_ERROR
  NO_CHECKING
  TIME_PRESSURE
  OTHER
}

enum PreparationLevel {
  ZERO
  BEGINNER
  BASIC
  CONFIDENT
}

enum DiagnosticStatus {
  IN_PROGRESS
  COMPLETED
}

enum StudentRoadmapStatus {
  ACTIVE
  ARCHIVED
}

enum RoadmapMilestoneStatus {
  PLANNED
  ACTIVE
  COMPLETED
  DEFERRED
}

enum QueueDecisionState {
  ACTIVE
  SNOOZED
  HELP_REQUESTED
  DISMISSED
}

enum RecoveryReason {
  OVERLOAD
  ILLNESS
  SCHOOL_LOAD
  LOW_MOTIVATION
  OTHER
}

enum RecoveryStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ErrorCorrectionStatus {
  OPEN
  CORRECTED
  VERIFIED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CourseItemType {
  THEORY
  PRACTICE
  HOMEWORK
  WEBINAR
  VARIANT
  CONTROL
  ERROR_REVIEW
  OTHER
}

enum DiagnosticTemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum DiagnosticTaskLevel {
  FOUNDATION
  BASIC
  ADVANCED
  EXAM
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(STUDENT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedHomeworks  HomeworkAssignment[]
  attempts           Attempt[]
  practiceAttempts   PracticeAttempt[]
  variantAttempts    VariantAttempt[]
  variantAssignments VariantAssignment[]
  reminderDeliveries ReminderDelivery[]
  studyPlans         StudentStudyPlan[]
  aiGenerations      AiGeneration[]
  activitySessions   StudentActivitySession[]
  preparationProfile StudentPreparationProfile?
  diagnosticAttempts StudentDiagnosticAttempt[]
  roadmaps           StudentRoadmap[]
  queueDecisions     StudentQueueDecision[]
  recoveryPeriods    StudentRecoveryPeriod[]
  errorCorrections   StudentErrorCorrection[]
  courseEnrollments  StudentCourseEnrollment[]

  lastActivityAt DateTime?

  studentStatus      StudentAccountStatus @default(ACTIVE)
  webinarAccessUntil DateTime?
  frozenAt           DateTime?
  archivedAt         DateTime?
  sessionVersion     Int                  @default(0)

  telegramChatId               String?   @unique
  telegramUsername             String?
  telegramLinkedAt             DateTime?
  telegramNotificationsEnabled Boolean   @default(false)
  telegramLinkTokenHash        String?   @unique
  telegramLinkTokenExpiresAt   DateTime?

  @@index([role, studentStatus])
}

model StudentPreparationProfile {
  studentId      String           @id
  targetScore    Int
  examDate       DateTime
  weeklyMinutes  Int
  sessionMinutes Int
  preferredDays  Json
  currentLevel   PreparationLevel
  completedAt    DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([examDate])
}

model StudentDiagnosticAttempt {
  id          String           @id @default(cuid())
  studentId   String
  templateId  String?
  status      DiagnosticStatus @default(IN_PROGRESS)
  score       Int              @default(0)
  maxScore    Int              @default(0)
  startedAt   DateTime         @default(now())
  completedAt DateTime?

  student  User                    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  template DiagnosticTemplate?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  items    StudentDiagnosticItem[]
  roadmaps StudentRoadmap[]

  @@index([studentId, startedAt])
  @@index([studentId, status])
  @@index([templateId])
}

model StudentDiagnosticItem {
  id             String               @id @default(cuid())
  attemptId      String
  taskId         String
  taskRevisionId String
  order          Int
  level          DiagnosticTaskLevel?
  points         Int                  @default(1)

  rawAnswer        Json?
  normalizedAnswer Json?
  isCorrect        Boolean?
  countsForMastery Boolean  @default(true)

  attempt      StudentDiagnosticAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  task         Task                     @relation(fields: [taskId], references: [id], onDelete: Restrict)
  taskRevision TaskRevision             @relation(fields: [taskRevisionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, taskId])
  @@unique([attemptId, order])
  @@index([taskId])
  @@index([taskRevisionId])
}

model StudentRoadmap {
  id                 String               @id @default(cuid())
  studentId          String
  sourceDiagnosticId String?
  status             StudentRoadmapStatus @default(ACTIVE)
  targetScore        Int
  examDate           DateTime
  weeklyMinutes      Int
  generatedAt        DateTime             @default(now())
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  student          User                      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sourceDiagnostic StudentDiagnosticAttempt? @relation(fields: [sourceDiagnosticId], references: [id], onDelete: SetNull)
  milestones       StudentRoadmapMilestone[]

  @@index([studentId, status])
  @@index([studentId, generatedAt])
}

model StudentRoadmapMilestone {
  id                  String                 @id @default(cuid())
  roadmapId           String
  order               Int
  weekStart           DateTime
  title               String
  description         String
  egeNumbers          Json
  prerequisiteNumbers Json
  plannedMinutes      Int
  status              RoadmapMilestoneStatus @default(PLANNED)
  reason              String
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  roadmap StudentRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@unique([roadmapId, order])
  @@index([roadmapId, weekStart])
  @@index([status, weekStart])
}

model StudentQueueDecision {
  id              String             @id @default(cuid())
  studentId       String
  itemKey         String
  state           QueueDecisionState @default(ACTIVE)
  scheduledFor    DateTime?
  note            String?
  helpRequestedAt DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, itemKey])
  @@index([studentId, state, scheduledFor])
}

model StudentRecoveryPeriod {
  id            String         @id @default(cuid())
  studentId     String
  status        RecoveryStatus @default(ACTIVE)
  reason        RecoveryReason
  weeklyMinutes Int
  mainGoal      String
  startedAt     DateTime       @default(now())
  endsAt        DateTime
  reviewAt      DateTime
  completedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, status])
  @@index([reviewAt])
}

model StudentErrorCorrection {
  id              String                @id @default(cuid())
  studentId       String
  evidenceKey     String
  taskId          String
  taskRevisionId  String
  errorCause      LearningErrorCause?
  reflection      String?
  correctedAnswer Json?
  status          ErrorCorrectionStatus @default(OPEN)
  scheduledFor    DateTime?
  correctedAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  student      User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Restrict)
  taskRevision TaskRevision @relation(fields: [taskRevisionId], references: [id], onDelete: Restrict)

  @@unique([studentId, evidenceKey])
  @@index([studentId, status, scheduledFor])
  @@index([taskId])
  @@index([taskRevisionId])
}

model StudentActivitySession {
  id               String   @id @default(cuid())
  studentId        String
  browserSessionId String   @unique
  startedAt        DateTime @default(now())
  lastSeenAt       DateTime @default(now())
  lastPath         String?
  pageViews        Int      @default(1)
  createdAt        DateTime @default(now())

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, startedAt])
  @@index([studentId, lastSeenAt])
}

model AnnualCourse {
  id          String       @id @default(cuid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  status      CourseStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  modules             CourseModule[]
  scheduleItems       CourseScheduleItem[]
  skillLevels         CourseSkillLevel[]
  skillNodes          CourseSkillNode[]
  enrollments         StudentCourseEnrollment[]
  diagnosticTemplates DiagnosticTemplate[]

  @@index([status, startDate])
}

model CourseSkillLevel {
  id          String   @id @default(cuid())
  courseId    String
  order       Int
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course AnnualCourse     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  nodes  CourseSkillNode[]

  @@unique([courseId, order])
  @@index([courseId, order])
}

model CourseSkillNode {
  id               String   @id @default(cuid())
  courseId         String
  levelId          String
  order            Int
  egeNumber        Int
  title            String
  description      String?
  estimatedMinutes Int      @default(120)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  course            AnnualCourse           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  level             CourseSkillLevel        @relation(fields: [levelId], references: [id], onDelete: Cascade)
  prerequisiteLinks CourseSkillDependency[] @relation("SkillNodePrerequisites")
  dependentLinks    CourseSkillDependency[] @relation("SkillNodeDependents")

  @@unique([courseId, egeNumber])
  @@unique([levelId, order])
  @@index([courseId, levelId])
}

model CourseSkillDependency {
  nodeId         String
  prerequisiteId String

  node         CourseSkillNode @relation("SkillNodePrerequisites", fields: [nodeId], references: [id], onDelete: Cascade)
  prerequisite CourseSkillNode @relation("SkillNodeDependents", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@id([nodeId, prerequisiteId])
  @@index([prerequisiteId])
}

model CourseModule {
  id          String   @id @default(cuid())
  courseId    String
  order       Int
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  egeNumbers  Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course        AnnualCourse         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  scheduleItems CourseScheduleItem[]

  @@unique([courseId, order])
  @@index([courseId, startDate])
}

model CourseScheduleItem {
  id               String         @id @default(cuid())
  courseId         String
  moduleId         String?
  order            Int
  type             CourseItemType
  title            String
  description      String?
  scheduledFor     DateTime
  estimatedMinutes Int            @default(30)
  href             String?
  egeNumbers       Json
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  course AnnualCourse  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module CourseModule? @relation(fields: [moduleId], references: [id], onDelete: SetNull)

  @@unique([courseId, order])
  @@index([courseId, scheduledFor])
  @@index([moduleId, scheduledFor])
}

model StudentCourseEnrollment {
  id                   String   @id @default(cuid())
  courseId             String
  studentId            String
  diagnosticTemplateId String?
  isActive             Boolean  @default(true)
  joinedAt             DateTime @default(now())
  updatedAt            DateTime @updatedAt

  course             AnnualCourse        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student            User                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  diagnosticTemplate DiagnosticTemplate? @relation(fields: [diagnosticTemplateId], references: [id], onDelete: SetNull)

  @@unique([courseId, studentId])
  @@index([studentId, isActive])
  @@index([diagnosticTemplateId])
}

model DiagnosticTemplate {
  id              String                   @id @default(cuid())
  courseId        String
  title           String
  description     String?
  durationMinutes Int                      @default(45)
  version         Int                      @default(1)
  status          DiagnosticTemplateStatus @default(DRAFT)
  publishedAt     DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  course      AnnualCourse               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  items       DiagnosticTemplateItem[]
  attempts    StudentDiagnosticAttempt[]
  enrollments StudentCourseEnrollment[]

  @@unique([courseId, version])
  @@index([courseId, status])
}

model DiagnosticTemplateItem {
  id             String              @id @default(cuid())
  templateId     String
  taskId         String
  taskRevisionId String
  order          Int
  level          DiagnosticTaskLevel
  points         Int                 @default(1)
  createdAt      DateTime            @default(now())

  template     DiagnosticTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  task         Task               @relation(fields: [taskId], references: [id], onDelete: Restrict)
  taskRevision TaskRevision       @relation(fields: [taskRevisionId], references: [id], onDelete: Restrict)

  @@unique([templateId, taskId])
  @@unique([templateId, order])
  @@index([taskId])
  @@index([taskRevisionId])
}

model StudentStudyPlan {
  id                String          @id @default(cuid())
  studentId         String
  generationId      String          @unique
  status            StudyPlanStatus @default(DRAFT)
  title             String
  summary           String
  durationDays      Int
  topics            Json
  actions           Json
  analyticsSnapshot Json
  teacherEditedAt   DateTime?
  confirmedAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  student          User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  generation       AiGeneration      @relation(fields: [generationId], references: [id], onDelete: Cascade)
  practiceAttempts PracticeAttempt[]

  @@index([studentId, createdAt])
  @@index([studentId, status])
}

model AiGeneration {
  id                String             @id @default(cuid())
  studentId         String
  provider          String
  status            AiGenerationStatus @default(PENDING)
  analyticsSnapshot Json
  outputSnapshot    Json?
  errorMessage      String?
  startedAt         DateTime           @default(now())
  completedAt       DateTime?

  student   User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studyPlan StudentStudyPlan?

  @@index([studentId, startedAt])
  @@index([status, startedAt])
}

model Task {
  id                String           @id @default(cuid())
  egeNumber         Int
  title             String
  statementHtml     String
  referenceHtml     String?
  answerType        TaskAnswerType
  correctAnswer     Json
  hintHtml          String?
  explanationHtml   String?
  videoUrl          String?
  source            String?
  difficulty        Int?
  skillTag          String?
  isArchived        Boolean          @default(false)
  isPublic          Boolean          @default(true)
  attachments       TaskAttachment[]
  currentRevisionId String?          @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  homeworkTasks           HomeworkTask[]
  attemptAnswers          AttemptAnswer[]
  practiceAttempts        PracticeAttempt[]
  variantTasks            VariantTask[]
  variantAnswers          VariantAttemptAnswer[]
  diagnosticItems         StudentDiagnosticItem[]
  errorCorrections        StudentErrorCorrection[]
  diagnosticTemplateItems DiagnosticTemplateItem[]
  revisions               TaskRevision[]           @relation("TaskRevisions")
  currentRevision         TaskRevision?            @relation("CurrentTaskRevision", fields: [currentRevisionId], references: [id], onDelete: Restrict)

  @@index([egeNumber])
  @@index([egeNumber, skillTag])
  @@index([isPublic, isArchived, egeNumber])
}

model TaskRevision {
  id              String         @id @default(cuid())
  taskId          String
  version         Int
  egeNumber       Int
  title           String
  statementHtml   String
  referenceHtml   String?
  answerType      TaskAnswerType
  correctAnswer   Json
  hintHtml        String?
  explanationHtml String?
  videoUrl        String?
  source          String?
  difficulty      Int?
  skillTag        String?
  isPublic        Boolean        @default(true)
  changeNote      String?
  createdAt       DateTime       @default(now())

  task                    Task                     @relation("TaskRevisions", fields: [taskId], references: [id], onDelete: Restrict)
  currentForTask          Task?                    @relation("CurrentTaskRevision")
  attachments             TaskRevisionAttachment[]
  homeworkTasks           HomeworkTask[]
  attemptAnswers          AttemptAnswer[]
  practiceAttempts        PracticeAttempt[]
  variantTasks            VariantTask[]
  variantAnswers          VariantAttemptAnswer[]
  diagnosticItems         StudentDiagnosticItem[]
  errorCorrections        StudentErrorCorrection[]
  diagnosticTemplateItems DiagnosticTemplateItem[]

  @@unique([taskId, version])
  @@index([taskId, createdAt])
  @@index([egeNumber, skillTag])
}

model TaskAttachment {
  id String @id @default(cuid())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  originalName String
  storedName   String @unique
  extension    String
  mimeType     String
  sizeBytes    Int

  createdAt DateTime @default(now())

  revisionLinks TaskRevisionAttachment[]

  @@index([taskId])
}

model TaskRevisionAttachment {
  id           String @id @default(cuid())
  revisionId   String
  attachmentId String
  order        Int

  revision   TaskRevision   @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  attachment TaskAttachment @relation(fields: [attachmentId], references: [id], onDelete: Restrict)

  @@unique([revisionId, attachmentId])
  @@unique([revisionId, order])
  @@index([attachmentId])
}

model Homework {
  id          String         @id @default(cuid())
  title       String
  description String?
  deadline    DateTime?
  status      HomeworkStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks       HomeworkTask[]
  assignments HomeworkAssignment[]
  attempts    Attempt[]
}

model HomeworkTask {
  id             String @id @default(cuid())
  homeworkId     String
  taskId         String
  taskRevisionId String
  order          Int

  homework     Homework     @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskRevision TaskRevision @relation(fields: [taskRevisionId], references: [id], onDelete: Restrict)

  @@unique([homeworkId, taskId])
  @@index([homeworkId])
  @@index([taskId])
  @@index([taskRevisionId])
}

model HomeworkAssignment {
  id         String @id @default(cuid())
  homeworkId String
  studentId  String

  assignedAt DateTime @default(now())

  homework Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student  User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([homeworkId, studentId])
  @@index([homeworkId])
  @@index([studentId])
}

model Attempt {
  id         String        @id @default(cuid())
  homeworkId String
  studentId  String
  status     AttemptStatus @default(IN_PROGRESS)

  score    Int   @default(0)
  maxScore Int   @default(0)
  percent  Float @default(0)

  startedAt   DateTime  @default(now())
  submittedAt DateTime?

  homework Homework        @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student  User            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers  AttemptAnswer[]

  @@index([homeworkId])
  @@index([studentId])
}

model AttemptAnswer {
  id             String @id @default(cuid())
  attemptId      String
  taskId         String
  taskRevisionId String

  rawAnswer        Json
  normalizedAnswer Json?
  isCorrect        Boolean @default(false)
  countsForMastery Boolean @default(true)

  attempt      Attempt      @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskRevision TaskRevision @relation(fields: [taskRevisionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, taskId])
  @@index([attemptId])
  @@index([taskId])
  @@index([taskRevisionId])
}

model PracticeAttempt {
  id                   String                @id @default(cuid())
  studentId            String
  taskId               String
  taskRevisionId       String
  studyPlanId          String?
  studyPlanActionIndex Int?
  studyPlanAttemptKind StudyPlanAttemptKind?
  errorCause           LearningErrorCause?

  rawAnswer        Json
  normalizedAnswer Json?
  isCorrect        Boolean               @default(false)
  countsForMastery Boolean               @default(true)
  feedbackStage    PracticeFeedbackStage @default(SOLUTION)

  createdAt DateTime @default(now())

  student      User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  task         Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskRevision TaskRevision      @relation(fields: [taskRevisionId], references: [id], onDelete: Restrict)
  studyPlan    StudentStudyPlan? @relation(fields: [studyPlanId], references: [id], onDelete: SetNull)

  @@index([studentId, createdAt])
  @@index([studentId, taskId])
  @@index([studyPlanId, studyPlanActionIndex, createdAt])
  @@index([errorCause, createdAt])
  @@index([taskId])
  @@index([taskRevisionId])
}

model ExamVariant {
  id              String        @id @default(cuid())
  title           String
  description     String?
  status          VariantStatus @default(DRAFT)
  durationMinutes Int           @default(235)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks       VariantTask[]
  attempts    VariantAttempt[]
  assignments VariantAssignment[]

  @@index([status, createdAt])
}

model VariantTask {
  id             String @id @default(cuid())
  variantId      String
  taskId         String
  taskRevisionId String
  order          Int
  points         Int    @default(1)

  variant      ExamVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Restrict)
  taskRevision TaskRevision @relation(fields: [taskRevisionId], references: [id], onDelete: Restrict)

  @@unique([variantId, taskId])
  @@unique([variantId, order])
  @@index([variantId])
  @@index([taskId])
  @@index([taskRevisionId])
}

model VariantAttempt {
  id        String        @id @default(cuid())
  variantId String
  studentId String
  status    AttemptStatus @default(IN_PROGRESS)

  score    Int   @default(0)
  maxScore Int   @default(0)
  percent  Float @default(0)

  timerEnabled Boolean   @default(true)
  startedAt    DateTime  @default(now())
  submittedAt  DateTime?

  variant ExamVariant            @relation(fields: [variantId], references: [id], onDelete: Cascade)
  student User                   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers VariantAttemptAnswer[]

  @@index([variantId, submittedAt])
  @@index([studentId, submittedAt])
  @@index([studentId, variantId, status])
}

model VariantAssignment {
  id         String    @id @default(cuid())
  variantId  String
  studentId  String
  deadline   DateTime?
  assignedAt DateTime  @default(now())

  variant ExamVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  student User        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([variantId, studentId])
  @@index([studentId, assignedAt])
  @@index([variantId])
}

model VariantAttemptAnswer {
  id             String @id @default(cuid())
  attemptId      String
  taskId         String
  taskRevisionId String

  rawAnswer        Json
  normalizedAnswer Json?
  isCorrect        Boolean @default(false)
  awardedPoints    Int     @default(0)
  countsForMastery Boolean @default(true)

  attempt      VariantAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  task         Task           @relation(fields: [taskId], references: [id], onDelete: Restrict)
  taskRevision TaskRevision   @relation(fields: [taskRevisionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, taskId])
  @@index([attemptId])
  @@index([taskId])
  @@index([taskRevisionId])
}

model ReminderDelivery {
  id           String               @id @default(cuid())
  studentId    String
  channel      ReminderChannel      @default(TELEGRAM)
  kind         ReminderKind
  resourceType ReminderResourceType
  resourceId   String
  deadlineAt   DateTime
  sentAt       DateTime             @default(now())

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, channel, kind, resourceType, resourceId, deadlineAt])
  @@index([studentId, sentAt])
  @@index([resourceType, resourceId])
}

model Webinar {
  id            String               @id @default(cuid())
  title         String
  description   String?
  contentHtml   String
  videoUrl      String
  videoEmbedUrl String?
  videoProvider WebinarVideoProvider @default(RUTUBE)
  status        WebinarStatus        @default(DRAFT)
  topic         String?
  egeNumber     Int?

  eventDate   DateTime?
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  materials WebinarMaterial[]

  @@index([status])
  @@index([eventDate])
  @@index([publishedAt])
}

model WebinarMaterial {
  id        String              @id @default(cuid())
  webinarId String
  title     String
  url       String
  type      WebinarMaterialType @default(LINK)
  order     Int                 @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  webinar Webinar @relation(fields: [webinarId], references: [id], onDelete: Cascade)

  @@index([webinarId])
}

model WebinarSchedule {
  id           String   @id @default(cuid())
  topic        String
  announcement String?
  joinUrl      String
  scheduledAt  DateTime
  isPublished  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, scheduledAt])
  @@index([scheduledAt])
}
