generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  TEACHER
  STUDENT
}

enum StudentAccountStatus {
  ACTIVE
  FROZEN
  ARCHIVED
}

enum TaskAnswerType {
  TEXT
  NUMBER
  NUMBER_LIST
  PAIR_LIST_ORDERED
  PAIR_LIST_UNORDERED
}

enum HomeworkStatus {
  DRAFT
  ASSIGNED
  ARCHIVED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

enum ReminderChannel {
  TELEGRAM
}

enum ReminderKind {
  HOMEWORK_DUE_SOON
  HOMEWORK_OVERDUE
  VARIANT_DUE_SOON
  VARIANT_OVERDUE
}

enum ReminderResourceType {
  HOMEWORK
  VARIANT
}

enum VariantStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum WebinarVideoProvider {
  RUTUBE
  YANDEX_DISK
  EXTERNAL
}

enum WebinarStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum WebinarMaterialType {
  LINK
  CHEATSHEET
  PRESENTATION
  DOCUMENT
  CODE
  OTHER
}

enum StudyPlanStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum AiGenerationStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum StudyPlanAttemptKind {
  PRACTICE
  CONTROL
}

enum LearningErrorCause {
  THEORY_GAP
  ALGORITHM_GAP
  IMPLEMENTATION_ERROR
  CONDITION_READING
  CALCULATION_ERROR
  NO_CHECKING
  TIME_PRESSURE
  OTHER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(STUDENT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedHomeworks  HomeworkAssignment[]
  attempts           Attempt[]
  practiceAttempts   PracticeAttempt[]
  variantAttempts    VariantAttempt[]
  variantAssignments VariantAssignment[]
  reminderDeliveries ReminderDelivery[]
  studyPlans         StudentStudyPlan[]
  aiGenerations      AiGeneration[]
  activitySessions   StudentActivitySession[]

  lastActivityAt DateTime?

  studentStatus      StudentAccountStatus @default(ACTIVE)
  webinarAccessUntil DateTime?
  frozenAt           DateTime?
  archivedAt         DateTime?
  sessionVersion     Int                  @default(0)

  telegramChatId               String?   @unique
  telegramUsername             String?
  telegramLinkedAt             DateTime?
  telegramNotificationsEnabled Boolean   @default(false)
  telegramLinkTokenHash        String?   @unique
  telegramLinkTokenExpiresAt   DateTime?

  @@index([role, studentStatus])
}

model StudentActivitySession {
  id               String   @id @default(cuid())
  studentId        String
  browserSessionId String   @unique
  startedAt        DateTime @default(now())
  lastSeenAt       DateTime @default(now())
  lastPath         String?
  pageViews        Int      @default(1)
  createdAt        DateTime @default(now())

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, startedAt])
  @@index([studentId, lastSeenAt])
}

model StudentStudyPlan {
  id                String          @id @default(cuid())
  studentId         String
  generationId      String          @unique
  status            StudyPlanStatus @default(DRAFT)
  title             String
  summary           String
  durationDays      Int
  topics            Json
  actions           Json
  analyticsSnapshot Json
  teacherEditedAt   DateTime?
  confirmedAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  student          User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  generation       AiGeneration      @relation(fields: [generationId], references: [id], onDelete: Cascade)
  practiceAttempts PracticeAttempt[]

  @@index([studentId, createdAt])
  @@index([studentId, status])
}

model AiGeneration {
  id                String             @id @default(cuid())
  studentId         String
  provider          String
  status            AiGenerationStatus @default(PENDING)
  analyticsSnapshot Json
  outputSnapshot    Json?
  errorMessage      String?
  startedAt         DateTime           @default(now())
  completedAt       DateTime?

  student   User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studyPlan StudentStudyPlan?

  @@index([studentId, startedAt])
  @@index([status, startedAt])
}

model Task {
  id              String           @id @default(cuid())
  egeNumber       Int
  title           String
  statementHtml   String
  answerType      TaskAnswerType
  correctAnswer   Json
  explanationHtml String?
  videoUrl        String?
  source          String?
  difficulty      Int?
  skillTag        String?
  isArchived      Boolean          @default(false)
  isPublic        Boolean          @default(true)
  attachments     TaskAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  homeworkTasks    HomeworkTask[]
  attemptAnswers   AttemptAnswer[]
  practiceAttempts PracticeAttempt[]
  variantTasks     VariantTask[]
  variantAnswers   VariantAttemptAnswer[]

  @@index([egeNumber])
  @@index([egeNumber, skillTag])
  @@index([isPublic, isArchived, egeNumber])
}

model TaskAttachment {
  id String @id @default(cuid())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  originalName String
  storedName   String @unique
  extension    String
  mimeType     String
  sizeBytes    Int

  createdAt DateTime @default(now())

  @@index([taskId])
}

model Homework {
  id          String         @id @default(cuid())
  title       String
  description String?
  deadline    DateTime?
  status      HomeworkStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks       HomeworkTask[]
  assignments HomeworkAssignment[]
  attempts    Attempt[]
}

model HomeworkTask {
  id         String @id @default(cuid())
  homeworkId String
  taskId     String
  order      Int

  homework Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([homeworkId, taskId])
  @@index([homeworkId])
  @@index([taskId])
}

model HomeworkAssignment {
  id         String @id @default(cuid())
  homeworkId String
  studentId  String

  assignedAt DateTime @default(now())

  homework Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student  User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([homeworkId, studentId])
  @@index([homeworkId])
  @@index([studentId])
}

model Attempt {
  id         String        @id @default(cuid())
  homeworkId String
  studentId  String
  status     AttemptStatus @default(IN_PROGRESS)

  score    Int   @default(0)
  maxScore Int   @default(0)
  percent  Float @default(0)

  startedAt   DateTime  @default(now())
  submittedAt DateTime?

  homework Homework        @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student  User            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers  AttemptAnswer[]

  @@index([homeworkId])
  @@index([studentId])
}

model AttemptAnswer {
  id        String @id @default(cuid())
  attemptId String
  taskId    String

  rawAnswer        Json
  normalizedAnswer Json?
  isCorrect        Boolean @default(false)

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([attemptId, taskId])
  @@index([attemptId])
  @@index([taskId])
}

model PracticeAttempt {
  id                   String                @id @default(cuid())
  studentId            String
  taskId               String
  studyPlanId          String?
  studyPlanActionIndex Int?
  studyPlanAttemptKind StudyPlanAttemptKind?
  errorCause           LearningErrorCause?

  rawAnswer        Json
  normalizedAnswer Json?
  isCorrect        Boolean @default(false)

  createdAt DateTime @default(now())

  student   User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  task      Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  studyPlan StudentStudyPlan? @relation(fields: [studyPlanId], references: [id], onDelete: SetNull)

  @@index([studentId, createdAt])
  @@index([studentId, taskId])
  @@index([studyPlanId, studyPlanActionIndex, createdAt])
  @@index([errorCause, createdAt])
  @@index([taskId])
}

model ExamVariant {
  id              String        @id @default(cuid())
  title           String
  description     String?
  status          VariantStatus @default(DRAFT)
  durationMinutes Int           @default(235)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks       VariantTask[]
  attempts    VariantAttempt[]
  assignments VariantAssignment[]

  @@index([status, createdAt])
}

model VariantTask {
  id        String @id @default(cuid())
  variantId String
  taskId    String
  order     Int
  points    Int    @default(1)

  variant ExamVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  task    Task        @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@unique([variantId, taskId])
  @@unique([variantId, order])
  @@index([variantId])
  @@index([taskId])
}

model VariantAttempt {
  id        String        @id @default(cuid())
  variantId String
  studentId String
  status    AttemptStatus @default(IN_PROGRESS)

  score    Int   @default(0)
  maxScore Int   @default(0)
  percent  Float @default(0)

  timerEnabled Boolean   @default(true)
  startedAt    DateTime  @default(now())
  submittedAt  DateTime?

  variant ExamVariant            @relation(fields: [variantId], references: [id], onDelete: Cascade)
  student User                   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers VariantAttemptAnswer[]

  @@index([variantId, submittedAt])
  @@index([studentId, submittedAt])
  @@index([studentId, variantId, status])
}

model VariantAssignment {
  id         String    @id @default(cuid())
  variantId  String
  studentId  String
  deadline   DateTime?
  assignedAt DateTime  @default(now())

  variant ExamVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  student User        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([variantId, studentId])
  @@index([studentId, assignedAt])
  @@index([variantId])
}

model VariantAttemptAnswer {
  id        String @id @default(cuid())
  attemptId String
  taskId    String

  rawAnswer        Json
  normalizedAnswer Json?
  isCorrect        Boolean @default(false)
  awardedPoints    Int     @default(0)

  attempt VariantAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  task    Task           @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@unique([attemptId, taskId])
  @@index([attemptId])
  @@index([taskId])
}

model ReminderDelivery {
  id           String               @id @default(cuid())
  studentId    String
  channel      ReminderChannel      @default(TELEGRAM)
  kind         ReminderKind
  resourceType ReminderResourceType
  resourceId   String
  deadlineAt   DateTime
  sentAt       DateTime             @default(now())

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, channel, kind, resourceType, resourceId, deadlineAt])
  @@index([studentId, sentAt])
  @@index([resourceType, resourceId])
}

model Webinar {
  id            String               @id @default(cuid())
  title         String
  description   String?
  contentHtml   String
  videoUrl      String
  videoEmbedUrl String?
  videoProvider WebinarVideoProvider @default(RUTUBE)
  status        WebinarStatus        @default(DRAFT)
  topic         String?
  egeNumber     Int?

  eventDate   DateTime?
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  materials WebinarMaterial[]

  @@index([status])
  @@index([eventDate])
  @@index([publishedAt])
}

model WebinarMaterial {
  id        String              @id @default(cuid())
  webinarId String
  title     String
  url       String
  type      WebinarMaterialType @default(LINK)
  order     Int                 @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  webinar Webinar @relation(fields: [webinarId], references: [id], onDelete: Cascade)

  @@index([webinarId])
}

model WebinarSchedule {
  id           String   @id @default(cuid())
  topic        String
  announcement String?
  joinUrl      String
  scheduledAt  DateTime
  isPublished  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, scheduledAt])
  @@index([scheduledAt])
}
